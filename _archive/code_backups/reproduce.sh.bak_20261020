#!/usr/bin/env bash
# 재현 1단계: ORT(PC CPU) 최종 결과를 처음부터 다시 만든다. GPU 불필요.
#   데이터 다운로드 → 분할 재생성·sha256 확인 → FP32 ONNX export + P1 게이트 → 양자화(A1, SPL-b567-k32)
#   → COCO-confirm 검색 + CIFAR-100 test → 속도 측정 → 기대값과 비교
# 사용법:  bash reproduce.sh            (전부, 약 2~4시간. 대부분 다운로드와 평가)
#          SKIP_BENCH=1 bash reproduce.sh  (속도 측정 생략, 정확도만)
# 큰 파일 위치: 환경변수 HALIO_DATA_DIR (없으면 /mnt/d 가 보일 때 /mnt/d/halio_data, 아니면 이 폴더)
# 재현 결과는 코드 이름 앞에 RP- 를 붙여 저장한다(원래 결과 파일을 덮어쓰지 않음)
set -euo pipefail
cd "$(dirname "$0")"
export CUDA_VISIBLE_DEVICES=''          # GPU 가 있어도 CPU 로만 (원 실험과 같은 조건)
THREADS=${THREADS:-4}
VENV=${VENV:-$HOME/venvs/halio}
[ -f "$VENV/bin/activate" ] || { echo "파이썬 환경이 없습니다: $VENV  (docs/06_재현가이드.md 3단계)"; exit 1; }
source "$VENV/bin/activate"
M=$(python -m src.common models-dir); mkdir -p "$M/imp" logs results
LOG=logs/reproduce_$(date +%Y%m%d_%H%M).log
exec > >(tee -a "$LOG") 2>&1
echo "== 재현 시작 $(date '+%F %T') / 큰 파일: $(python -m src.common store-dir) / 로그: $LOG"
python - <<'PY'
import onnxruntime, torch, numpy, open_clip, platform
print(f"   python {platform.python_version()} | torch {torch.__version__} | ORT {onnxruntime.__version__} | numpy {numpy.__version__} | open_clip {open_clip.__version__}")
PY

echo "== 1/7 데이터 다운로드 (CIFAR-100, COCO val2017, COCO 캡션)"
python -m src.download_data
BK=$(mktemp -d); cp splits/*.txt "$BK"/          # 분할 재생성 전에 원본 보관

echo "== 2/7 분할 재생성 → 제출본과 sha256 비교"
python -m src.split_val
python -m src.coco_retrieval prepare
if (cd splits && sha256sum -c ../repro/SHA256SUMS_splits.txt --quiet); then
  echo "   분할 일치: 제출본과 같은 사진 목록"
else
  echo "   ✘ 분할 불일치. 원본으로 되돌리고 계속합니다 (데이터 버전 확인 필요)"; cp "$BK"/*.txt splits/
fi

echo "== 3/7 FP32 ONNX export + P1 게이트 (PyTorch 와 출력 일치 확인)"
[ -f logs/p1_parity.json ] && [ ! -f logs/p1_parity.submitted.json ] && cp logs/p1_parity.json logs/p1_parity.submitted.json
[ -f "$M/clip_vitb16_image_fp32.onnx" ] || python -m src.export_onnx
python - <<'PY'
import json; d = json.load(open("logs/p1_parity.json"))
print("   P1:", {k: v for k, v in d.items() if not isinstance(v, (list, dict))})
PY

echo "== 4/7 양자화"
CAL=splits/calib_coco_64_s0.txt
[ -f "$M/a1_dynamic.onnx" ] || python -m src.quantize_ort --mode dynamic --out "$M/a1_dynamic.onnx"
F="$M/imp/split_SPL-b567-k32.fp32.onnx"
[ -f "$F" ] || python -m src.split_outliers --blocks 5,6,7 --k 32 --calib-list $CAL --out "$F"
[ -f "$M/imp/SPL-b567-k32.onnx" ] || python -m src.quantize_ort --mode static --weight-matmul-only --per-channel \
    --src "$F" --exclude-nodes-file "$F.hot_nodes.txt" --calib-list $CAL --out "$M/imp/SPL-b567-k32.onnx"

echo "== 5/7 정확도: COCO-confirm 검색 + CIFAR-100 test"
python -m src.coco_retrieval text
for c in "RP-A0 $M/clip_vitb16_image_fp32.onnx fp32" "RP-A1 $M/a1_dynamic.onnx dynamic" "RP-SPL-b567-k32 $M/imp/SPL-b567-k32.onnx static"; do
  set -- $c
  [ -f "results/coco_ret/$1-confirm.json" ] || python -m src.coco_retrieval eval --model "$2" --code "$1" --split confirm --i-know-final
  [ -f "results/preds/$1-test.json" ] || python -m src.evaluate --model "$2" --code "$1" --quant-mode "$3" --eval-set test --i-know-final --threads "$THREADS" --out-csv results/accuracy_repro.csv
done
python -m src.coco_retrieval table --ref RP-A0 --codes RP-A0 RP-A1 RP-SPL-b567-k32 --split confirm --margin 2.0 --tag repro

if [ "${SKIP_BENCH:-0}" != "1" ]; then
  echo "== 6/7 속도·메모리 (다른 프로그램을 끄세요. 부하가 낮아질 때까지 최대 30분 대기)"
  for i in $(seq 1 60); do l=$(cut -d' ' -f1 /proc/loadavg); awk "BEGIN{exit !($l < 2.0)}" && break; sleep 30; done
  echo "   CPU: $(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2) / 부하 $(cut -d' ' -f1-3 /proc/loadavg)"
  python -m src.benchmark --threads "$THREADS" --out-csv results/latency_repro.csv \
      --models RP-A0="$M/clip_vitb16_image_fp32.onnx" RP-A1="$M/a1_dynamic.onnx" RP-SPL-b567-k32="$M/imp/SPL-b567-k32.onnx"
else
  echo "== 6/7 속도 측정 생략 (SKIP_BENCH=1)"
fi

echo "== 7/7 기대값과 비교"
python repro/check_expected.py
echo "== 끝 $(date '+%F %T') / 로그: $LOG"
