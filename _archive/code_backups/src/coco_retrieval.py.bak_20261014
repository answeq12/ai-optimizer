"""주 평가: COCO val2017 텍스트→이미지 검색 (Recall@1/5/10). "갤러리 사진을 문장으로 찾기" 시나리오.

  python -m src.coco_retrieval prepare                 # 캡션 다운로드, select/confirm 분할, 교집합 0 확인
  python -m src.coco_retrieval text                    # FP32 텍스트 인코더로 캡션 임베딩 (한 번만, 전 구성 공용)
  python -m src.coco_retrieval eval --model M.onnx --code A0            # COCO-select 로 평가
  python -m src.coco_retrieval table --ref A0 --codes A0 A1 A2 ...       # 비교표 + 이미지 단위 부트스트랩
  python -m src.coco_retrieval eval ... --split confirm --i-know-final  # 후보 확정 후 한 번만

설계
- 캘리브레이션에 쓴 COCO 이미지(splits/calib_coco_* 전부)를 제외하고, 남은 이미지를 image_id 기준
  고정 시드로 반분: COCO-select(후보 고르기용) / COCO-confirm(확정 후 한 번만, 보고서 최종 숫자)
- 텍스트 쪽은 FP32 텍스트 인코더로 고정(open_clip ViT-B-16, openai 가중치 = 이미지 인코더와 같은 모델).
  캡션은 템플릿 없이 원문. 이미지 쪽만 구성별로 바꾼다
- 갤러리 = 해당 반쪽 이미지 전부, 질의 = 그 이미지들의 캡션 전부(장당 약 5개)
- 같은 이미지의 캡션은 독립이 아니므로 신뢰구간은 이미지 단위 부트스트랩
- 전처리는 CIFAR 경로와 같은 C.preprocess (짧은 변 224 bicubic + 중앙 자르기 + CLIP 정규화)
"""
from __future__ import annotations

import argparse
import json
import sys
import time
import zipfile
from pathlib import Path

import numpy as np
from PIL import Image

from . import common as C

ANN_URL = "http://images.cocodataset.org/annotations/annotations_trainval2017.zip"
ANN_DIR = C.DATA / "coco" / "annotations"
CAP_JSON = ANN_DIR / "captions_val2017.json"
SPLIT_SEED = 2026
OUT = C.RESULTS / "coco_ret"


def split_path(name: str) -> Path:
    return C.SPLITS / f"coco_ret_{name}.txt"


def read_split(name: str) -> list[str]:
    lines = split_path(name).read_text().split("\n")
    return [ln.strip() for ln in lines[1:] if ln.strip()]


def calib_coco_files() -> set[str]:
    s = set()
    for p in sorted(C.SPLITS.glob("calib_coco_*.txt")):
        lines = p.read_text().split("\n")
        if lines[0].strip() == "# source=coco":
            s |= {ln.strip() for ln in lines[1:] if ln.strip()}
    return s


def cmd_prepare() -> None:
    if not CAP_JSON.exists():
        from .download_data import _download
        ANN_DIR.mkdir(parents=True, exist_ok=True)
        z = C.DATA / "coco" / "annotations_trainval2017.zip"
        if not z.exists():
            print("[coco-ret] 캡션 다운로드 (약 241MB)")
            _download(ANN_URL, z)
        with zipfile.ZipFile(z) as zf:
            CAP_JSON.write_bytes(zf.read("annotations/captions_val2017.json"))
    ann = json.loads(CAP_JSON.read_text())
    have = {p.name for p in C.COCO_DIR.glob("*.jpg")}
    imgs = sorted((im["id"], im["file_name"]) for im in ann["images"] if im["file_name"] in have)
    calib = calib_coco_files()
    pool = [(i, f) for i, f in imgs if f not in calib]
    rng = np.random.default_rng(SPLIT_SEED)
    perm = rng.permutation(len(pool))
    half = len(pool) // 2
    sel = sorted(pool[j] for j in perm[:half])
    con = sorted(pool[j] for j in perm[half:])
    for name, rows in (("select", sel), ("confirm", con)):
        split_path(name).write_text(f"# source=coco_ret_{name} seed={SPLIT_SEED}\n" + "\n".join(f for _, f in rows) + "\n")
    s, c = set(read_split("select")), set(read_split("confirm"))
    assert not (s & c), "select/confirm 겹침"
    assert not (s & calib) and not (c & calib), "캘리브레이션 이미지가 평가에 섞임"
    print(f"[coco-ret] 전체 {len(imgs)}장, 캘리브레이션 제외 {len(imgs) - len(pool)}장 "
          f"(calib_coco_* 합집합 {len(calib)}장) -> select {len(s)} / confirm {len(c)}. 교집합 0 확인")


def captions_for(split: str):
    ann = json.loads(CAP_JSON.read_text())
    files = read_split(split)
    fid = {im["file_name"]: im["id"] for im in ann["images"]}
    order = {fid[f]: k for k, f in enumerate(files)}
    caps = sorted(((order[a["image_id"]], a["id"], a["caption"].strip()) for a in ann["annotations"]
                   if a["image_id"] in order))
    return files, np.array([c[0] for c in caps], dtype=np.int64), [c[2] for c in caps]


def text_path(split: str) -> Path:
    return C.MODELS / f"coco_ret_text_{split}.npy"


def cmd_text() -> None:
    import open_clip
    import torch
    model = open_clip.create_model(C.MODEL_NAME, pretrained=C.PRETRAINED, force_quick_gelu=True,
                                   cache_dir=str(C.CACHE)).eval()
    tok = open_clip.get_tokenizer(C.MODEL_NAME)
    for split in ("select", "confirm"):
        p = text_path(split)
        if p.exists():
            print(f"[coco-ret] {p.name} 이미 있음")
            continue
        _, img_of, caps = captions_for(split)
        out = []
        t0 = time.time()
        with torch.no_grad():
            for i in range(0, len(caps), 256):
                e = model.encode_text(tok(caps[i:i + 256])).float().numpy()
                out.append(e / np.linalg.norm(e, axis=1, keepdims=True))
        np.save(p, np.concatenate(out).astype(np.float32))
        (p.with_suffix(".json")).write_text(json.dumps(
            {"split": split, "n_captions": len(caps), "n_images": int(img_of.max() + 1),
             "model": f"{C.MODEL_NAME}/{C.PRETRAINED} (open_clip, FP32)", "template": "없음(원문)",
             "seconds": round(time.time() - t0, 1)}, indent=2, ensure_ascii=False))
        print(f"[coco-ret] {split}: 캡션 {len(caps)}개 임베딩 ({time.time() - t0:.0f}s)")


def ranks(img_emb: np.ndarray, txt_emb: np.ndarray, img_of: np.ndarray) -> np.ndarray:
    """각 캡션의 정답 이미지 순위 (0 = 1등)."""
    r = np.empty(len(txt_emb), dtype=np.int64)
    for i in range(0, len(txt_emb), 2048):
        s = txt_emb[i:i + 2048] @ img_emb.T
        gt = s[np.arange(len(s)), img_of[i:i + 2048]]
        r[i:i + 2048] = (s > gt[:, None]).sum(axis=1)
    return r


def cmd_eval(a) -> None:
    if a.split == "confirm" and not a.i_know_final:
        sys.exit("COCO-confirm 은 후보 확정 후 한 번만 엽니다. --i-know-final 을 함께 주세요.")
    from .backends import OnnxBackend
    files, img_of, _ = captions_for(a.split)
    txt = np.load(text_path(a.split))
    be = OnnxBackend(a.model, a.code, a.threads)
    emb = np.empty((len(files), txt.shape[1]), dtype=np.float32)
    t0 = time.time()
    for k, f in enumerate(files):
        e = be.encode_image(C.preprocess(Image.open(C.COCO_DIR / f))[None])
        emb[k] = e / np.linalg.norm(e)
        if (k + 1) % 500 == 0:
            print(f"  {k + 1}/{len(files)} ({time.time() - t0:.0f}s)", flush=True)
    save_and_report(a.code, a.split, emb, img_of, txt, {"model": str(a.model), "backend": be.name})


def save_and_report(code, split, emb, img_of, txt, extra: dict) -> dict:
    r = ranks(emb, txt, img_of)
    OUT.mkdir(parents=True, exist_ok=True)
    np.savez_compressed(OUT / f"{code}-{split}.npz", emb=emb, ranks=r, img_of=img_of)
    res = {"code": code, "split": split, "n_images": len(emb), "n_captions": len(r),
           **{f"R@{k}": float((r < k).mean()) for k in (1, 5, 10)}, "median_rank": float(np.median(r) + 1),
           "timestamp": C.now(), **extra}
    (OUT / f"{code}-{split}.json").write_text(json.dumps(res, indent=2, ensure_ascii=False))
    print(f"[coco-ret] {code} ({split}, 이미지 {len(emb)} / 캡션 {len(r)}): "
          f"R@1 {res['R@1']:.2%}  R@5 {res['R@5']:.2%}  R@10 {res['R@10']:.2%}")
    return res


def per_image(ranks_: np.ndarray, img_of: np.ndarray, nimg: int, k: int) -> np.ndarray:
    """이미지별 검색 성적 = 그 이미지 캡션들의 hit@k 평균. 갤러리는 고정."""
    n = np.bincount(img_of, minlength=nimg).astype(np.float64)
    return np.bincount(img_of, weights=(ranks_ < k).astype(np.float64), minlength=nimg) / n


def cmd_table(a) -> None:
    """이미지 단위 짝지은 bootstrap. 같은 이미지 재표집을 모든 구성에 동일하게 적용한다.
    갤러리는 고정(중복 이미지를 넣지 않음), 재표집 대상은 '이미지별 성적'뿐이다. McNemar 는 쓰지 않는다."""
    data = {c: np.load(OUT / f"{c}-{a.split}.npz") for c in a.codes}
    img_of = data[a.ref]["img_of"]
    nimg = int(img_of.max() + 1)
    for c, d in data.items():
        assert np.array_equal(d["img_of"], img_of), f"{c}: 질의 순서가 다름"
    rng = np.random.default_rng(0)
    idx = rng.integers(0, nimg, size=(a.boot, nimg))          # 모든 구성에 같은 재표집
    ref = {k: per_image(data[a.ref]["ranks"], img_of, nimg, k) for k in (1, 5, 10)}
    m = a.margin
    L = [f"# COCO 텍스트→이미지 검색 ({a.split}, 갤러리 {nimg}장 / 질의 캡션 {len(img_of)}개)", "",
         f"자체 COCO val2017 분할. 이미지별 성적(캡션 hit@K 평균)의 평균. 95% CI = 이미지 단위 짝지은 bootstrap {a.boot}회.",
         f"비열등 = FP32({a.ref}) 대비 R@1 차이의 CI 하한 ≥ −{m}%p (선택 규칙 초안, 값은 팀이 확정).", "",
         f"| 구성 | R@1 [95% CI] | R@5 | R@10 | R@1 차이 vs {a.ref} [95% CI] | R@5 차이 | R@10 차이 | 비열등(−{m}%p) |",
         "|---|---|---|---|---|---|---|---|"]
    for c in a.codes:
        cur = {k: per_image(data[c]["ranks"], img_of, nimg, k) for k in (1, 5, 10)}
        b1 = cur[1][idx].mean(axis=1)
        lo, hi = np.percentile(b1, [2.5, 97.5])
        diffs = {}
        for k in (1, 5, 10):
            bd = (cur[k] - ref[k])[idx].mean(axis=1) * 100
            diffs[k] = ((cur[k] - ref[k]).mean() * 100, *np.percentile(bd, [2.5, 97.5]))
        ok = "—" if c == a.ref else ("예" if diffs[1][1] >= -m else "아니오")
        fmt = lambda t: f"{t[0]:+.2f} [{t[1]:+.2f}, {t[2]:+.2f}]"
        L.append(f"| {c} | {cur[1].mean():.2%} [{lo:.2%}, {hi:.2%}] | {cur[5].mean():.2%} | {cur[10].mean():.2%} | "
                 f"{fmt(diffs[1])} | {fmt(diffs[5])} | {fmt(diffs[10])} | {ok} |")
    L += ["", "- 텍스트 인코더는 FP32 고정, 이미지 인코더만 구성별로 다르다. 차이 단위는 %p",
          "- 자체 분할 결과라 공개 COCO 1K/5K 검색 수치와 직접 비교하지 않는다"]
    out = C.RESULTS / f"coco_ret_{a.split}{('_' + a.tag) if a.tag else ''}.md"
    out.write_text("\n".join(L) + "\n")
    print("\n".join(L))


def cmd_check() -> None:
    """정합성: 우리 이미지 ONNX(A0) / open_clip 텍스트 인코더가 HF openai/clip-vit-base-patch16 과 같은 공간인지."""
    import torch
    from transformers import CLIPModel, CLIPProcessor
    from .backends import OnnxBackend
    files, img_of, caps = captions_for("select")
    hf = CLIPModel.from_pretrained("openai/clip-vit-base-patch16", cache_dir=str(C.CACHE)).eval()
    proc = CLIPProcessor.from_pretrained("openai/clip-vit-base-patch16", cache_dir=str(C.CACHE))
    be = OnnxBackend(C.FP32_ONNX, "A0")
    ci, ct = [], []
    txt = np.load(text_path("select"))
    with torch.no_grad():
        for f in files[:20]:
            im = Image.open(C.COCO_DIR / f).convert("RGB")
            a = be.encode_image(C.preprocess(im)[None]); a = a / np.linalg.norm(a)
            x = torch.from_numpy(C.preprocess(im)[None])      # 같은 전처리 텐서를 HF 에 넣어 모델만 비교
            b = hf.get_image_features(pixel_values=x)[0].numpy(); b = b / np.linalg.norm(b)
            ci.append(float(a @ b))
        for j in range(20):
            t = proc(text=[caps[j]], return_tensors="pt", padding=True)
            b = hf.get_text_features(**t)[0].numpy(); b = b / np.linalg.norm(b)
            ct.append(float(txt[j] @ b))
    res = {"image_onnx_vs_hf_min_cos": min(ci), "image_mean_cos": float(np.mean(ci)),
           "text_openclip_vs_hf_min_cos": min(ct), "text_mean_cos": float(np.mean(ct)),
           "pass": min(ci) >= 0.9999 and min(ct) >= 0.9999, "n": 20, "timestamp": C.now()}
    OUT.mkdir(parents=True, exist_ok=True)
    (OUT / "check_hf.json").write_text(json.dumps(res, indent=2))
    print(f"[coco-ret] 정합성: 이미지 최소 코사인 {min(ci):.6f}, 텍스트 최소 코사인 {min(ct):.6f} -> "
          f"{'통과' if res['pass'] else '확인 필요'}")


def cmd_statslist(n: int = 64) -> None:
    """활성값 통계 재측정용: COCO-select 앞쪽 n장 목록 (# source=coco 형식, act_stats 입력)."""
    files = read_split("select")[:n]
    p = C.SPLITS / f"stats_coco_select_{n}.txt"
    p.write_text("# source=coco\n" + "\n".join(files) + "\n")
    print(f"[coco-ret] {p.name} ({len(files)}장, 측정 전용 — 캘리브레이션에 쓰지 않음)")


def main() -> None:
    ap = argparse.ArgumentParser()
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("prepare")
    sub.add_parser("text")
    pe = sub.add_parser("eval")
    pe.add_argument("--model", required=True)
    pe.add_argument("--code", required=True)
    pe.add_argument("--split", default="select", choices=["select", "confirm"])
    pe.add_argument("--i-know-final", action="store_true")
    pe.add_argument("--threads", type=int, default=C.DEFAULT_THREADS)
    pt = sub.add_parser("table")
    pt.add_argument("--ref", default="A0")
    pt.add_argument("--codes", nargs="+", required=True)
    pt.add_argument("--split", default="select")
    pt.add_argument("--boot", type=int, default=2000)
    pt.add_argument("--margin", type=float, default=1.0, help="비열등 허용 손실(%p). 팀 확정 전 초안 값")
    pt.add_argument("--tag", default="")
    sub.add_parser("check")
    sub.add_parser("statslist")
    a = ap.parse_args()
    C.ensure_dirs()
    {"prepare": lambda: cmd_prepare(), "text": lambda: cmd_text(),
     "eval": lambda: cmd_eval(a), "table": lambda: cmd_table(a),
     "check": lambda: cmd_check(), "statslist": lambda: cmd_statslist()}[a.cmd]()


if __name__ == "__main__":
    main()
